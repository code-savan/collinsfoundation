# Paystack public key (test or live) — required for the donation form to accept payments.
# Get yours from https://dashboard.paystack.com/#/settings/developer
# Until this is set, the donation form will fall back to showing bank transfer details.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Optional: Email service provider key for the newsletter signup (see app/api/subscribe/route.js)
# MAILCHIMP_API_KEY=
